# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/roi_clone?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-change-in-production"

# Discord OAuth
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Email (optional - for password reset)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="user"
EMAIL_SERVER_PASSWORD="password"
EMAIL_FROM="noreply@yourdomain.com"

# Domain verification
DOMAIN_VERIFICATION_TOKEN_SECRET="domain-verification-secret-change-in-production"

# SSL (Let's Encrypt / ACME)
ACME_EMAIL="admin@yourdomain.com"
ACME_DIRECTORY_URL="https://acme-v02.api.letsencrypt.org/directory"

# Storage (for assets)
STORAGE_TYPE="local"
STORAGE_LOCAL_PATH="./public/uploads"
# AWS S3 (alternative)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""
# AWS_S3_BUCKET=""

# Rate limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Cloning engine
PUPPETEER_EXECUTABLE_PATH=""
CLONE_TIMEOUT_MS="120000"

# Analytics
ANALYTICS_ENABLED="true"